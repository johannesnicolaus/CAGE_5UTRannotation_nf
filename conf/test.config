/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run luscombeu/utrannotation -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: C. elegans test set (tests/testdata/make_testdata.py; public data):
    // chromosome III 4.8-5.2 Mb of WBcel235, the WormBase WS298 gene set (RefSeq format) with
    // over-extended UTRs, and SLIC-CAGE TSS clusters (SRR10568191) as a cagescan results
    // directory (sample ce_cagescan) and as BED files (sample ce_bed)
    input = "${projectDir}/tests/testdata/samplesheet.csv"
}
