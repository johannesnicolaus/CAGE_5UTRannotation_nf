/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'GUNZIP' {
        publishDir = [ enabled: false ]
    }

    withName: 'CAGE_TSS_TABLE' {
        ext.args   = { "--sl-min-fraction ${params.sl_min_fraction}" }
        publishDir = [
            path: { "${params.outdir}/tss" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SCAN_PAS' {
        ext.args   = { "--motifs ${params.pas_motifs}" }
        publishDir = [
            path: { "${params.outdir}/pas" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ANNOTATE_UTR5' {
        ext.args   = {
            [
                "--max-dist ${params.tss_max_dist}",
                "--selection ${params.tss_selection}",
                "--min-rel ${params.tss_min_rel}",
                "--min-count ${params.tss_min_count}",
                "--min-utr-len ${params.utr5_min_len}",
                "--sl-window-up ${params.sl_window_up}",
                "--sl-window-down ${params.sl_window_down}",
                params.tss_rel_whole_utr ? '' : '--rel-window-only',
                params.tss_noncoding ? '' : '--coding-only',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/annotation/intermediate" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'ANNOTATE_UTR3' {
        ext.args   = {
            [
                "--window ${params.pas_window}",
                "--offset ${params.pas_offset}",
                params.keep_polya_evidence ? '' : '--no-keep-polya-evidence',
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: { "${params.outdir}/annotation" },
                mode: params.publish_dir_mode,
                pattern: '*.gff3'
            ],
            [
                path: { "${params.outdir}/annotation/intermediate" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
        ]
    }

    withName: 'AGAT_CONVERTSPGFF2GTF' {
        ext.prefix = { "${meta.id}.utr" }
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.agat.gtf') ? filename.replace('.agat.gtf', '.gtf') : null }
        ]
    }

    withName: 'GFFREAD' {
        ext.args   = { meta.seqtype == 'proteins' ? '-y' : '-w' }
        ext.prefix = { "${meta.id}.utr.${meta.seqtype}" }
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ANNOTATE_OPERONS' {
        ext.args   = {
            [
                "--gap-from ${params.operon_gap_from}",
                "--max-gap-cds ${params.operon_max_gap}",
                "--max-gap-tx ${params.operon_max_gap_tx}",
                "--split-min-count ${params.operon_split_min_count}",
                "--split-rule ${params.operon_split_rule}",
                "--sl-window-up ${params.sl_window_up}",
                "--sl-window-down ${params.sl_window_down}",
                "--biotypes ${params.operon_biotypes}",
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/operons" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'UTR_STATS' {
        publishDir = [
            path: { "${params.outdir}/stats" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'AGAT_SPSTATISTICS' {
        ext.prefix = { "${meta.id}.${meta.stage}" }
        publishDir = [
            path: { "${params.outdir}/stats/agat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
